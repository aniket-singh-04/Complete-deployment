pipeline {
    agent { label 'buildah' }

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    tools { 
        // tools used in this pipeline are defined in the Jenkins global configuration. The name of the tool is used to reference it in the pipeline.
        nodejs 'node26'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log --oneline -n 3'
            }
        }

        stage('Tool versions') {
            steps {
                sh 'node --version && npm --version'
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build image') {
            steps {
                sh '''
                    buildah --storage-driver=vfs build --isolation=chroot \
                      -t devops-app:${BUILD_NUMBER} .
                    buildah --storage-driver=vfs images
                '''
            }
        }

        stage('Verify image') {
            steps {
                sh '''
                    set -eu
                    ctr=$(buildah --storage-driver=vfs from localhost/devops-app:${BUILD_NUMBER})
                    trap 'buildah --storage-driver=vfs rm "$ctr" >/dev/null' EXIT
                    out=$(buildah --storage-driver=vfs run --isolation=chroot --network host "$ctr" -- \
                          sh -c 'PORT=4444 node index.js & pid=$!; sleep 3; wget -qO- http://127.0.0.1:4444/health; kill $pid')
                    echo "$out"
                    echo "$out" | grep -q '"status":"OK"'
                '''
            }
        }
    }
}