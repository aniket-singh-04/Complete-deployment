pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    tools { 
        // tools used in this pipeline are defined in the Jenkins global configuration. The name of the tool is used to reference it in the pipeline.
        nodejs 'node26'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log --oneline -n 3'
            }
        }

        stage('Tool versions') {
            steps {
                sh 'node --version && npm --version'
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'npm ci'
            }
        }
    }
}