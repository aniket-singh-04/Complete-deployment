pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log --oneline -n 3'
            }
        }

        stage('Inspect workspace') {
            steps {
                sh 'ls -la'
            }
        }
    }
}